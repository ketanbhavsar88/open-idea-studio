# Copy to .env and fill in. Never commit .env.

# --- PostgreSQL (used by docker compose and the API) ---
POSTGRES_DB=ideastudio
POSTGRES_USER=ideastudio
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# --- AI provider (used by the API app only) ---
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemma-4-26b-a4b-it

# --- Optional local fallback (docker compose --profile local-llm) ---
OLLAMA_PORT=11434
