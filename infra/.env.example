# Copy to .env and fill in. Never commit .env.
# Read by docker compose AND by the API (apps/api). See docs/ai-providers.md.

# --- PostgreSQL (used by docker compose and the API) ---
POSTGRES_DB=ideastudio
POSTGRES_USER=ideastudio
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# --- AI provider (used by the API only; never sent to the browser) ---
# gemini (default) | ollama (local) | fake (canned demo replies, no model)
AI_PROVIDER=gemini
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemma-4-26b-a4b-it
# Set to false for older Gemma models that reject system instructions.
GEMINI_SUPPORTS_SYSTEM_PROMPT=true

# Optional tuning (defaults shown)
# AI_TIMEOUT_SECONDS=60
# AI_MAX_RETRIES=2            # extra attempts after invalid JSON from the model
# AI_MIN_INTERVAL_MS=4000     # minimum gap between model calls (free-tier rate limits)
# AI_MODEL_DISCOVERY_TURN=        # per-operation model overrides (empty = GEMINI_MODEL/OLLAMA_MODEL)
# AI_MODEL_GENERATE_FLOW=
# AI_MODEL_PROPOSE_FLOW_CHANGE=

# --- Optional local fallback (docker compose --profile local-llm) ---
OLLAMA_PORT=11434
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=gemma3:4b      # pull first: docker compose exec ollama ollama pull gemma3:4b
